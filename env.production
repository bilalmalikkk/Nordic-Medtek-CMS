NODE_ENV=production
PORT=3001
DATABASE_PATH=./database/cms.db
JWT_SECRET=your-strong-jwt-secret-here
FRONTEND_URL=https://www.nordicmedtek.no
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@nordicmedtek.no
DEFAULT_ADMIN_PASSWORD=your-secure-password-here
BCRYPT_ROUNDS=10
MAX_FILE_SIZE=10485760

# SMTP Configuration for ITpays
SMTP_HOST=mail.itpays.no
SMTP_PORT=587
SMTP_USER=kontakt@nordicrvm.com
SMTP_PASS=your-email-password-here
CONTACT_EMAIL=kontakt@nordicrvm.com
